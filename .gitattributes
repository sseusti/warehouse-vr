# Normalize line endings: text is stored with LF in the repository.
* text=auto

# Unity YAML. Unity writes LF on every OS, so keep LF in the working copy too.
# The unityyamlmerge driver must be registered once per machine (see the plan, "Work together").
*.unity        text eol=lf merge=unityyamlmerge
*.prefab       text eol=lf merge=unityyamlmerge
*.asset        text eol=lf merge=unityyamlmerge
*.meta         text eol=lf
*.mat          text eol=lf
*.anim         text eol=lf
*.controller   text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable     text eol=lf
*.mask         text eol=lf
*.brush        text eol=lf
*.flare        text eol=lf
*.fontsettings text eol=lf
*.guiskin      text eol=lf
*.giparams     text eol=lf
*.renderTexture text eol=lf
*.spriteatlas  text eol=lf
*.terrainlayer text eol=lf
*.mixer        text eol=lf
*.shadervariants text eol=lf
*.preset       text eol=lf
*.inputactions text eol=lf
*.asmdef       text eol=lf
*.asmref       text eol=lf

# Code and scripts
*.cs     text eol=lf diff=csharp
*.shader text eol=lf
*.cginc  text eol=lf
*.hlsl   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.ps1    text eol=crlf

